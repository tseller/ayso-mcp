{
  "name": "mcp-billcom",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node --env-file=.env dist/index.js",
    "dev": "node --env-file=.env --import=tsx src/index.ts",
    "start:http": "MCP_TRANSPORT=http node --env-file=.env dist/index.js",
    "gmail:link": "node --env-file=.env --import=tsx src/scripts/gmail-link.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "amazon-cognito-identity-js": "^6.3.22",
    "express": "^5.2.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
